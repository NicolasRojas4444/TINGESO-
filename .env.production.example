# Copy to .env.production on the server. Never commit the completed file.
# HTTPS origin only: no trailing slash, /api or /auth.
PUBLIC_URL=https://sigarojas.duckdns.org
BACKEND_IMAGE=your-dockerhub-user/siga-backend:release-tag
FRONTEND_IMAGE=your-dockerhub-user/siga-frontend:release-tag

POSTGRES_DB=siga
POSTGRES_USER=siga
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REGISTRATION_CLIENT_SECRET=
KEYCLOAK_REQUEST_TIMEOUT_SECONDS=10

# Fresh DB: use update for the first start with ONE backend (see deployment guide).
# Once the schema exists, use validate and start all three replicas.
JPA_DDL_AUTO=validate

# Mount the entire Certbot directory, including live/ and archive/.
# Nginx uses live/sigarojas.duckdns.org/{fullchain,privkey}.pem inside it.
# Do not commit certificates/private keys. Remove the old TLS_CERTIFICATE_FILE
# and TLS_PRIVATE_KEY_FILE settings if upgrading an existing .env.production.
LETSENCRYPT_DIRECTORY=/etc/letsencrypt
